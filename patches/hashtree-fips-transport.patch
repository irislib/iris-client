+/** FIPS packet bytes at the transport boundary, including control and forwarded
+ * traffic. Excludes carrier overhead and Nostr signalling. Totals last until stop. */
+export class BrowserNetworkStats {
+    peers = new Map();
+    totals = new Map();
+    key(address) {
+        return `${address.transport}:${address.addr}`;
+    }
+    peer(event) {
+        const key = this.key(event.remoteAddr);
+        if (event.state === 'disconnected') {
+            this.peers.delete(key);
+            return;
+        }
+        if (this.peers.get(key)?.peerId === event.remotePubkey)
+            return;
+        this.peers.set(key, {
+            peerId: event.remotePubkey,
+            transport: event.remoteAddr.transport,
+            address: event.remoteAddr.addr,
+            bytesSent: 0,
+            bytesReceived: 0,
+        });
+    }
+    clearPeers() {
+        this.peers.clear();
+    }
+    snapshot() {
+        return {
+            peers: [...this.peers.values()].map((peer) => ({ ...peer })),
+            transports: Object.fromEntries([...this.totals].map(([name, totals]) => [name, { ...totals }])),
+        };
+    }
+    traffic(address, direction, bytes) {
+        const total = this.totals.get(address.transport);
+        total[direction] += bytes;
+        const peer = this.peers.get(this.key(address));
+        if (peer)
+            peer[direction] += bytes;
+    }
+    observe(transport) {
+        this.totals.set(transport.type, { bytesSent: 0, bytesReceived: 0 });
+        return {
+            type: transport.type,
+            mtu: transport.mtu,
+            maxFrameBytes: transport.maxFrameBytes,
+            identityMayChangeAtAddress: transport.identityMayChangeAtAddress,
+            start: (context) => transport.start({
+                ...context,
+                onPacket: (packet) => {
+                    this.traffic(packet.remoteAddr, 'bytesReceived', packet.data.byteLength);
+                    context.onPacket(packet);
+                },
+                onConnectionState: (event) => {
+                    if (event.state === 'disconnected' || event.state === 'failed') {
+                        this.peers.delete(this.key(event.remoteAddr));
+                    }
+                    context.onConnectionState?.(event);
+                },
+            }),
+            stop: () => transport.stop(),
+            connect: (address) => transport.connect(address),
+            send: async (address, packet) => {
+                await transport.send(address, packet);
+                this.traffic(address, 'bytesSent', packet.byteLength);
+            },
+            close: transport.close?.bind(transport),
+            discover: transport.discover?.bind(transport),
+            resolve: transport.resolve?.bind(transport),
+            companionTransports: transport.companionTransports?.bind(transport),
+            handlePeerRestart: transport.handlePeerRestart?.bind(transport),
+            handleSessionEstablished: transport.handleSessionEstablished?.bind(transport),
+            handleLinkNegotiation: transport.handleLinkNegotiation?.bind(transport),
+        };
+    }
+}
