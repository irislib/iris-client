{
  "name": "iris",
  "private": true,
  "version": "2.5.63",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-client",
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-client",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-client?tab=issues"
  },
  "description": "Nostr client",
  "author": "Martti Malmi",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:groups": "NODE_CONFIG_ENV=groups vite",
    "dev:local": "VITE_USE_LOCAL_RELAY=true vite",
    "dev:test": "VITE_USE_TEST_RELAY=true vite",
    "dev:relay": "pnpm relay:start -- --seed 80000 --port 7777",
    "relay:start": "node --import tsx dev-relay/node-relay.ts",
    "start": "vite",
    "verify:dependency-lock": "node ./scripts/verify-dependency-lock.mjs",
    "build": "pnpm verify:social-graph && pnpm verify:dependency-lock && tsc && vite build --mode production",
    "build:groups": "pnpm verify:social-graph && pnpm verify:dependency-lock && tsc && NODE_CONFIG_ENV=groups vite build --mode production",
    "build:dev": "pnpm verify:social-graph && tsc && vite build --mode development",
    "build:analyze": "pnpm verify:social-graph && tsc && vite build --mode production",
    "knip": "knip",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --fix",
    "preview": "vite preview",
    "preview:groups": "NODE_CONFIG_ENV=groups vite preview",
    "pretest": "playwright install --with-deps chromium",
    "test": "pnpm verify:dependency-lock && vitest run && playwright test --reporter=list",
    "test:unit": "pnpm verify:dependency-lock && vitest run",
    "test:ci": "pnpm verify:dependency-lock && vitest run && playwright test --reporter=list",
    "test:ci:e2e": "playwright test --reporter=list,html",
    "test:local": "vitest run && playwright test --reporter=list --workers=1",
    "test:ui": "playwright test --ui",
    "test:ui:testrelay": "VITE_USE_TEST_RELAY=true playwright test --ui",
    "test:performance": "playwright test tests/user-journey.spec.ts --grep \"core user journey\" --reporter=list --workers=1",
    "test:performance:prod": "pnpm build && IRIS_E2E_BUILT_DIST=true playwright test tests/user-journey.spec.ts --grep \"core user journey\" --reporter=list --workers=1",
    "test:release:e2e": "IRIS_E2E_BUILT_DIST=true playwright test --reporter=list",
    "lighthouse": "pnpm build && node ./scripts/lighthouse-test.js",
    "lighthouse:json": "pnpm build && node ./scripts/lighthouse-test.js --json",
    "lighthouse:open": "pnpm build && node ./scripts/lighthouse-test.js --open",
    "smoke:portable": "node ./scripts/smoke-iris-portable.mjs",
    "devpublish": "node ./scripts/devpublish-iris.mjs",
    "devpublish:iris": "node ./scripts/devpublish-iris.mjs",
    "publish:iris": "node ./scripts/publish-iris-build.mjs",
    "release:iris": "node ./scripts/release-site.mjs",
    "release:groups": "node ./scripts/release-groups.mjs",
    "format": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|css|md)\"",
    "format:check": "prettier --check \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|css|md)\"",
    "typecheck": "tsc --noEmit",
    "test:release:chat": "IRIS_E2E_BUILT_DIST=true IRIS_E2E_LOCAL_RELAY=true playwright test tests/chat-registration.spec.ts tests/group-admin-edit.spec.ts tests/multi-device-groups.spec.ts --workers=2 --reporter=list",
    "verify:social-graph": "tsx ./scripts/updateSocialGraph.ts --verify",
    "update:social-graph": "tsx ./scripts/updateSocialGraph.ts --refresh",
    "test:release:search": "IRIS_E2E_BUILT_DIST=true IRIS_E2E_LOCAL_RELAY=true playwright test tests/post-relevance.spec.ts --workers=1 --reporter=list",
    "test:release:feed": "IRIS_E2E_BUILT_DIST=true IRIS_E2E_LOCAL_RELAY=true playwright test tests/for-you-replies.spec.ts tests/sparse-discovery.spec.ts --workers=1 --reporter=list",
    "test:graph-bootstrap": "playwright test --config playwright.graph-bootstrap.config.ts"
  },
  "build": {
    "extends": null,
    "appId": "com.nestr",
    "mac": {
      "icon": "src/assets/nest-logo-no-name.png"
    },
    "win": {
      "icon": "src/assets/nest-logo-no-name.png"
    },
    "nsis": {
      "installerIcon": "src/assets/nest-logo-no-name.png"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
