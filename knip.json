{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/service-worker.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "tests/**/*.spec.ts",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "src/debug/**",
    "src/lib/**"
  ],
  "ignoreDependencies": ["buffer"],
  "ignoreExportsUsedInFile": true,
  "playwright": {
    "entry": ["tests/**/*.spec.ts"]
  },
  "vite": {
    "config": ["vite.config.ts"]
  }
}
